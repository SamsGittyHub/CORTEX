{
  "name": "@cortex-ai/cortex-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the CORTEX web capability seam (ctx.web)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-web": "workspace:*"
  },
  "dependencies": {
    "@cortex-ai/cortex-util-values": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-spill-local": "workspace:*",
    "@cortex-ai/cortex-spill-policy": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tool-call-timeout-policy": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-web": "workspace:*",
    "@cortex-ai/cortex-web-fetch-http": "workspace:*",
    "@cortex-ai/cortex-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@cortex-ai/cortex-scope": "workspace:*",
    "@cortex-ai/cortex-token-meter": "workspace:*"
  }
