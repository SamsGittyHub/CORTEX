{
  "name": "@cortex-ai/cortex-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "cortex": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-app-boot": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-loader-smoke": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-checkpoint-policy": "workspace:*",
    "@cortex-ai/cortex-session-persistence-jsonl": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-subagent-codex": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cortex-subprocess-local": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*",
    "@cortex-ai/cortex-tool-jobs": "workspace:*",
    "@cortex-ai/cortex-tool-subagent": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*"
  }
}
