{
  "name": "@cortex-ai/cortex-subagent-cortex-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child CORTEX runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/subagent/subagent-cortex-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-sdk-client": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*"
  },
  "dependencies": {
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cordis-plugin-loader": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-instructions": "workspace:*",
    "@cortex-ai/cortex-app-boot": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-llm-deepseek": "workspace:*",
    "@cortex-ai/cortex-llm-deepseek-api-key": "workspace:*",
    "@cortex-ai/cortex-loader-smoke": "workspace:*",
    "@cortex-ai/cortex-sdk-client": "workspace:*",
    "@cortex-ai/cortex-sdk-protocol": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-checkpoint-policy": "workspace:*",
    "@cortex-ai/cortex-session-persistence-jsonl": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-skill-filesystem": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tool-subagent": "workspace:*"
  }
}
