{
  "name": "@cortex-ai/cortex-acp",
  "description": "Automation-only Agent Client Protocol server for driving CORTEX agents over JSON-RPC stdio",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-attachment": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-mcp-client": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-persistence": "workspace:*",
    "@cortex-ai/cortex-token-meter": "workspace:*",
    "@cortex-ai/cortex-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cortex-ai/cortex-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-loop": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-attachment": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-mcp-client": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-persistence": "workspace:*",
    "@cortex-ai/cortex-session-persistence-jsonl": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-token-meter": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-user-approval": "workspace:*"
  }
}
