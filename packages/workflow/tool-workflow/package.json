{
  "name": "@cortex-ai/cortex-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-jobs": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-workflow": "workspace:*"
  },
  "dependencies": {
    "@cortex-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-jobs": "workspace:*",
    "@cortex-ai/cortex-jobs-local": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tool-jobs": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-workflow": "workspace:*",
    "@cortex-ai/cortex-workflow-ptc": "workspace:*"
  }
}
