{
  "name": "@cortex-ai/cortex-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the CORTEX",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-scope": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cortex-util-values": "workspace:*",
    "@cortex-ai/cortex-workspace": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@cortex-ai/cortex-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-scope": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cortex-typert-registry": "workspace:*",
    "@cortex-ai/cortex-util-values": "workspace:*",
    "@cortex-ai/cortex-workspace": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  }
}
