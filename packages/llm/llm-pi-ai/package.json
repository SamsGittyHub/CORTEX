    "@cortex-ai/cortex-fs": "workspace:*",
    "@cortex-ai/cortex-launch-environment": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*",
    "@cortex-ai/cordis-plugin-loader": "workspace:~"
  },
  "dependencies": {
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/cortex-util-values": "workspace:*",
