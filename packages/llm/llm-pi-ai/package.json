    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-attachment": "workspace:*",
    "@cortex-ai/cortex-authorization": "workspace:*",
    "@cortex-ai/cortex-credentials": "workspace:*",
