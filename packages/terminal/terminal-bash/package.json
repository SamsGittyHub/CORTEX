{
  "name": "@cortex-ai/cortex-terminal-bash",
  "description": "Persistent shell PTY backend over the CORTEX subprocess terminal primitive",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-terminal": "workspace:*",
    "@cortex-ai/cortex-sandbox": "workspace:*",
    "@cortex-ai/cortex-sandbox-policy": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-session-projection": "workspace:*"
  },
  "dependencies": {
    "@cortex-ai/cortex-lazy-require": "workspace:*",
    "@cortex-ai/cortex-pwsh-local": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-terminal": "workspace:*",
    "@cortex-ai/cortex-sandbox": "workspace:*",
    "@cortex-ai/cortex-sandbox-policy": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cortex-subprocess-local": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  }
}
