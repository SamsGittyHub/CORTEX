{
  "name": "@cortex-ai/cortex-tui",
  "description": "The cortex interactive terminal bundle: a chat REPL over cortex-base with slash commands, /plan, and terminal approvals, and no Host, HTTP, or browser layer",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/bundle/tui"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "cortex": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/cortex-cmdline": "workspace:*",
    "@cortex-ai/cortex-memory": "workspace:*",
    "@cortex-ai/cortex-util-values": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^0.87.1",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cordis-plugin-loader": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-default-model": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-query": "workspace:*",
    "@cortex-ai/cortex-fs": "workspace:*",
    "@cortex-ai/cortex-commands": "workspace:*",
    "@cortex-ai/cortex-user-approval": "workspace:*",
    "@cortex-ai/cortex-user-questions": "workspace:*",
    "@cortex-ai/cortex-plan-mode": "workspace:*"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cordis-plugin-loader": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-default-model": "workspace:*",
    "@cortex-ai/cortex-agent-loop": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-query": "workspace:*",
    "@cortex-ai/cortex-fs": "workspace:*",
    "@cortex-ai/cortex-commands": "workspace:*",
    "@cortex-ai/cortex-user-approval": "workspace:*",
    "@cortex-ai/cortex-user-questions": "workspace:*",
    "@cortex-ai/cortex-plan-mode": "workspace:*"
  }
}
