{
  "name": "@cortex-ai/cortex-client-ui-permission-presets",
  "description": "Permission surfaces: a new-session default in General settings and a current-session /permission popup over the permissions projection",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/client/ui-permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "inject": [
        "@cortex-ai/cortex-api-session-controller",
        "@cortex-ai/cortex-client-connection",
        "@cortex-ai/cortex-client-locale",
        "@cortex-ai/cortex-client-ui-commands",
        "@cortex-ai/cortex-client-ui-conversation",
        "@cortex-ai/cortex-api-remotes",
        "@cortex-ai/cortex-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cortex-remote-mock": "workspace:*",
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-api-remotes": "workspace:*",
    "@cortex-ai/cortex-api-session-controller": "workspace:*",
    "@cortex-ai/cortex-client-connection": "workspace:*",
    "@cortex-ai/cortex-client-locale": "workspace:*",
    "@cortex-ai/cortex-client-store": "workspace:*",
    "@cortex-ai/cortex-client-test-runtime": "workspace:*",
    "@cortex-ai/cortex-client-ui-commands": "workspace:*",
    "@cortex-ai/cortex-client-ui-conversation": "workspace:*",
    "@cortex-ai/cortex-client-ui-primitives": "workspace:*",
    "@cortex-ai/cortex-client-ui-settings": "workspace:*",
    "@cortex-ai/cortex-client-ui-input-trigger": "workspace:*",
    "@cortex-ai/cortex-client-ui-slots": "workspace:*",
    "@cortex-ai/cortex-permission-presets": "workspace:*",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@cortex-ai/cortex-client-ui-renderer": "workspace:*",
    "@cortex-ai/cortex-client-ui-session": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
