{
  "name": "@cortex-ai/cortex-tool-cordis",
  "description": "Read-only runtime API inspection for Harness plugin development",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/extensions/tool-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/types/host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cordis-plugin-loader": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-app-boot": "workspace:*",
    "@cortex-ai/cortex-cordis-host-runner": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cordis-plugin-group": "workspace:~",
    "@cortex-ai/cordis-plugin-loader": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-app-boot": "workspace:*",
    "@cortex-ai/cortex-cordis-host-runner": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~"
  }
}
