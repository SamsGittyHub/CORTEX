{
  "name": "@cortex-ai/cortex-tool-lsp",
  "description": "Model-facing lsp tool over the CORTEX LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-lsp": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*"
  },
  "dependencies": {
    "@cortex-ai/cortex-util-values": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-fs-local": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-lsp": "workspace:*",
    "@cortex-ai/cortex-lsp-stdio": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-subprocess-local": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*",
    "@cortex-ai/cortex-tool-call-timeout-policy": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*"
  }
}
