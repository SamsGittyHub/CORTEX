{
  "name": "@cortex-ai/cortex-api-workspace-controller",
  "description": "Workspace Remote commands and reconnect-safe state transport",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/api/workspace-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./default-workspace": {
      "types": "./lib/types/default-workspace.d.ts",
      "default": "./lib/types/default-workspace.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cortex": {
    "client": {
      "external": [
        "@cortex-ai/cortex-api-gateway/client"
      ],
      "inject": [
        "@cortex-ai/cortex-api-gateway",
        "@cortex-ai/cortex-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex-ai/cortex-deque": "workspace:*",
    "@cortex-ai/cortex-native-command": "workspace:*",
    "@cortex-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-api-gateway": "workspace:*",
    "@cortex-ai/cortex-client-connection": "workspace:*",
    "@cortex-ai/cortex-host-directory-picker": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-storage-domain": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cortex-workspace": "workspace:*"
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-api-gateway": "workspace:*",
    "@cortex-ai/cortex-client-connection": "workspace:*",
    "@cortex-ai/cortex-client-store": "workspace:*",
    "@cortex-ai/cortex-client-test-runtime": "workspace:*",
    "@cortex-ai/cortex-host-directory-picker": "workspace:*",
    "@cortex-ai/cortex-remote-mock": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-storage-domain": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cortex-workspace": "workspace:*"
  }
}
