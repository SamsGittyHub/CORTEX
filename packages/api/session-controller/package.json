    "@cortex-ai/cortex-session-projection-cache": "workspace:*",
    "@cortex-ai/cortex-session-query": "workspace:*",
    "@cortex-ai/cortex-session-title": "workspace:*",
    "@cortex-ai/cortex-settings": "workspace:*",
    "@cortex-ai/cortex-skill": "workspace:*",
    "@cortex-ai/cortex-storage": "workspace:*",
