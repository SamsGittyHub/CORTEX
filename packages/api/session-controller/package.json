    "@cortex-ai/cortex-commands": "workspace:*",
    "@cortex-ai/cortex-credentials": "workspace:*",
    "@cortex-ai/cortex-file-reference": "workspace:*",
    "@cortex-ai/cortex-fs": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-native-command": "workspace:*",
    "@cortex-ai/cortex-scope": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-persistence": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-session-projection-cache": "workspace:*",
    "@cortex-ai/cortex-session-query": "workspace:*",
    "@cortex-ai/cortex-session-title": "workspace:*",
    "@cortex-ai/cortex-settings": "workspace:*",
    "@cortex-ai/cortex-skill": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cortex-typert-registry": "workspace:*",
    "@cortex-ai/cortex-util-time": "workspace:*",
    "@cortex-ai/cortex-util-values": "workspace:*",
    "@cortex-ai/cortex-util-workspace-path": "workspace:*",
    "@cortex-ai/cortex-workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
