{
  "name": "@cortex-ai/cortex-goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the CORTEX",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-scope": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@cortex-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-loop": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-bash-local": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-brand": "workspace:*",
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-loader-smoke": "workspace:*",
    "@cortex-ai/cortex-scope": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-checkpoint-policy": "workspace:*",
    "@cortex-ai/cortex-session-persistence-jsonl": "workspace:*",
    "@cortex-ai/cortex-subprocess-local": "workspace:*",
    "@cortex-ai/cortex-typert-protocol": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  }
}
