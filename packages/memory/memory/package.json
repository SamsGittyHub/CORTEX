{
  "name": "@cortex-ai/cortex-memory",
  "description": "Durable searchable memory across sessions: captured tool activity and turn summaries in SQLite full-text search, a session-start index, memory tools, and /memory commands",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/memory/memory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-commands": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cortex-ai/cortex-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cortex-ai/cordis": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-commands": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*"
  }
}
