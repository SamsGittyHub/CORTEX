{
  "name": "@cortex-ai/cortex-tool-todo",
  "description": "Model-facing todo_write tool over the CORTEX event-sourced session log",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/todo/tool-todo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cortex-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cordis-plugin-include": "workspace:~",
    "@cortex-ai/cordis-plugin-loader": "workspace:~",
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-loop": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-invariants": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-user-questions": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  }
}
