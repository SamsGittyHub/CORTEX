{
  "name": "@cortex-ai/cortex-fs-local",
  "description": "Local-filesystem implementation of the CORTEX filesystem seam (ctx.fs)",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cortex-fs": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "koffi": "3.1.1",
    "@cortex-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cortex-fs": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  }
}
