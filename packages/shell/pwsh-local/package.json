{
  "name": "@cortex-ai/cortex-pwsh-local",
  "description": "Local PowerShell implementation of the CORTEX bash executor seam",
  "version": "0.2.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cortex-shell": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@cortex-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@cortex-ai/cortex-shell": "workspace:*",
    "@cortex-ai/cortex-subprocess": "workspace:*",
    "@cortex-ai/cortex-subprocess-local": "workspace:*",
    "@cortex-ai/cortex-timeout": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  }
}
