{
  "name": "@cortex-ai/cortex-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the CORTEX Auto permission preset",
  "version": "0.2.0-rc.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-ai/cortex.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-instructions": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-permission-presets": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@cortex-ai/cortex-util-values": "workspace:*"
  },
  "devDependencies": {
    "@cortex-ai/cortex-agent": "workspace:*",
    "@cortex-ai/cortex-agent-instructions": "workspace:*",
    "@cortex-ai/cortex-agent-loop": "workspace:*",
    "@cortex-ai/cortex-agent-loop-testkit": "workspace:*",
    "@cortex-ai/cortex-bash-sandbox": "workspace:*",
    "@cortex-ai/cortex-compaction": "workspace:*",
    "@cortex-ai/cortex-fs-local": "workspace:*",
    "@cortex-ai/cortex-fs-observation-policy": "workspace:*",
    "@cortex-ai/cortex-fs-sandbox": "workspace:*",
    "@cortex-ai/cortex-llm": "workspace:*",
    "@cortex-ai/cortex-llm-deepseek": "workspace:*",
    "@cortex-ai/cortex-llm-deepseek-api-key": "workspace:*",
    "@cortex-ai/cortex-permission-presets": "workspace:*",
    "@cortex-ai/cortex-ptc-runtime-node": "workspace:*",
    "@cortex-ai/cortex-sandbox": "workspace:*",
    "@cortex-ai/cortex-sandbox-policy": "workspace:*",
    "@cortex-ai/cortex-session": "workspace:*",
    "@cortex-ai/cortex-session-projection": "workspace:*",
    "@cortex-ai/cortex-shell": "workspace:*",
    "@cortex-ai/cortex-shell-env": "workspace:*",
    "@cortex-ai/cortex-subagent": "workspace:*",
    "@cortex-ai/cortex-subprocess-local": "workspace:*",
    "@cortex-ai/cortex-system-prompt": "workspace:*",
    "@cortex-ai/cortex-tool-bash": "workspace:*",
    "@cortex-ai/cortex-tool-fs": "workspace:*",
    "@cortex-ai/cortex-tool-subagent": "workspace:*",
    "@cortex-ai/cortex-tools": "workspace:*",
    "@cortex-ai/cortex-user-approval": "workspace:*",
    "@cortex-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "cortex": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
